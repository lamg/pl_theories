import PlTheories
import Lean

/-!
Generates `styles/const-kinds.js`, which colours Verso's single `const`
token class by declaration kind: inductive types, constructors, and
definitions (including theorems) get different colours.

Verso renders all three kinds as `class="const token"` with only
`data-binding="const-<full name>"` to tell them apart, so this script
looks each name used on the site up in the Lean environment, where the
kind is exact, and emits the name-to-kind map the browser script needs.

Usage (from the repository root, after `lake build PlTheories` and a
site build have produced the HTML to scan):

```
python3 - <<'PY'
import re, glob
names = set()
for f in glob.glob('.lake/build/literate-html/**/*.html', recursive=True):
    names.update(re.findall(r'data-binding="const-([^"]+)"', open(f).read()))
open('/tmp/const-names.txt', 'w').write('\n'.join(sorted(names)) + '\n')
PY
lake env lean --run scripts/ConstKinds.lean /tmp/const-names.txt styles/const-kinds.js
```

Names not in the generated map keep the type colour, so new chapters
degrade gracefully until the map is regenerated.
-/

open Lean

/-- The colour class for a declaration, from its environment entry. -/
def kindOf (env : Environment) (n : Name) : String :=
  match env.find? n with
  | some (.ctorInfo _) => "ctor"
  | some (.inductInfo _) => "type"
  | some _ => "def"
  | none => "def"

def main (args : List String) : IO Unit := do
  let [namesFile, outFile] := args | throw (IO.userError "usage: ConstKinds.lean <names-file> <out-file>")
  let env ← importModules #[{ module := `PlTheories }] {}
  let contents ← IO.FS.readFile namesFile
  let names := contents.splitOn "\n" |>.map (·.trimAscii.toString) |>.filter (!·.isEmpty)
  let mut entries : Array String := #[]
  for name in names do
    entries := entries.push s!"    \"{Json.escape name}\": \"{kindOf env name.toName}\""
  let js := "/**\n" ++
    " * Generated by `scripts/ConstKinds.lean`; do not edit by hand.\n" ++
    " * Maps each `const` token's full name to its declaration kind so\n" ++
    " * constructors, inductive types, and definitions can be coloured\n" ++
    " * differently. Regenerate with the command in that file's header.\n" ++
    " */\n" ++
    "const versoConstKinds = {\n" ++ ",\n".intercalate entries.toList ++ "\n};\n" ++
    "for (const el of document.querySelectorAll('.hl.lean .const.token')) {\n" ++
    "  const binding = el.getAttribute('data-binding') || '';\n" ++
    "  const kind = versoConstKinds[binding.replace(/^const-/, '')];\n" ++
    "  if (kind === 'ctor') el.classList.add('const-ctor');\n" ++
    "  else if (kind === 'def') el.classList.add('const-def');\n" ++
    "}\n"
  IO.FS.writeFile outFile js
  IO.println s!"wrote {entries.size} entries to {outFile}"
